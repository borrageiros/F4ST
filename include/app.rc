  FILEFLAGS 0x0L
  FILEOS 0x40004L
  FILETYPE 0x1L
  FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "F4ST"
      VALUE "FileVersion", "1.2"
      VALUE "InternalName", "f4st"
      VALUE "OriginalFilename", "F4ST.exe"
      VALUE "CompanyName", "borrageiros"
      VALUE "LegalCopyright", "� 2019 Stefan Sundin, 2025 borrageiros"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
